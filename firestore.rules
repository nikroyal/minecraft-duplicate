rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' || 
        request.auth.token.role == 'master' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master'
      );
    }

    // 1. User Documents (Singleplayer Saves, Profile, Messages, Invites, Friend Requests)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if (isOwner(userId) && (!request.resource.data.keys().hasAny(['role', 'inventoryAdditions', 'healthOverride', 'teleportTarget', 'kickSignal', 'frozen']) || request.resource.data.role == 'player')) || isAdmin();
      
      // Allow owners to update everything except admin fields; allow signed-in players to deliver friendRequests/invites
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'inventoryAdditions', 'healthOverride', 'teleportTarget', 'kickSignal', 'frozen']))
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendRequests', 'invites', 'outgoingFriendRequests']))
                    || isAdmin();
                    
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 2. Custom Team & Group Rooms (Global Nexus cannot be deleted)
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || 
        isAdmin() || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['edits', 'chests', 'furnaces', 'members', 'lastActive', 'resetAt'])
      );
      
      // Global Nexus (nexus / global_nexus) cannot be deleted by anyone; team rooms can be deleted by owner or admin
      allow delete: if isSignedIn() && (roomId != 'nexus' && roomId != 'global_nexus') && (resource.data.ownerUid == request.auth.uid || isAdmin() || request.resource.data.deleted == true);
      
      // Presence sub-collection for real-time 3D multiplayer player coordinates
      match /presence/{playerId} {
        allow read: if isSignedIn();
        allow write: if isOwner(playerId) || isAdmin();
      }
    }

    // 3. Real-time Chat Threads & Direct Messages
    match /chats/{chatId} {
      allow read, create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read, create: if isSignedIn();
        allow update, delete: if isAdmin() || isOwner(resource.data.senderUid);
      }
    }

    // 4. Global Public Nexus World
    match /worlds/{worldId} {
      allow read, write: if isSignedIn();
    }

    // 5. Community Reviews & Bug Reports
    match /reviews/{reviewId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 6. Server Settings & Global Broadcast Banners
    match /server_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
